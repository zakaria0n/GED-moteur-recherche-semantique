# =====================================================================
# Modele de configuration — copier vers .env et renseigner les valeurs
#   cp .env.example .env
# Le fichier .env contient les secrets : il ne doit JAMAIS etre commité
# ni transmis (il est exclu du depot et des livrables).
# =====================================================================

# --- Base de donnees (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=semantic_search
DB_USER=root
DB_PASSWORD=
# Taille du pool de connexions
DB_POOL_SIZE=5

# --- CORS : origines autorisees du frontend (separees par des virgules) ---
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- URL de base du portail (liens de verification / reinitialisation email) ---
FRONTEND_BASE_URL=http://127.0.0.1:5500

# --- Cookie de session ---
SESSION_COOKIE_NAME=ged_auth
# true OBLIGATOIRE en production (HTTPS) ; false acceptable en dev local http
COOKIE_SECURE=false
# lax : front et back sur le meme site ; none : sous-domaines differents
# (dans ce cas COOKIE_SECURE=true est requis)
COOKIE_SAMESITE=lax

# --- SMTP (emails de verification de compte et de reinitialisation) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ged.local
SMTP_FROM_NAME=ged

# --- OCR des documents scannes (true recommande pour une GED) ---
OCR_ENABLED=true
# Threads pour l'OCR parallele (RapidOCR/ONNX libere le GIL)
OCR_WORKERS=4

# --- Moteur de recherche : index FAISS ---
# hnsw = approximatif sous-lineaire (grand corpus) ; flat = exact (petit corpus)
FAISS_INDEX_TYPE=hnsw
# Qualite/vitesse HNSW : voisins par noeud / profondeur de recherche
HNSW_M=32
HNSW_EF_SEARCH=64
